  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '"Pinned to the kitchen wall, written neatly:


    Form patties from ground
    beef and eggs, seasoned with soy sauce.

    Pan-fry with onions and pour over
    mushroom gravy.


    The smell alone makes every worker rush home early."'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 63e86bfcd2913ed40bbabfa03747da14, type: 2}
