      m_Calls: []
  m_text: "BANGO\r\n[English translation ]   Fragrance\r\nPang-uri (Adjective)\r\n
    Kahulugan (Tagalog): Katangian ng isang bagay o tao na may kaaya-ayang amoy.\r\n
    Meaning (English): Quality of someone or something having a pleasant scent.\r\n\r\n
    Halimbawa (Filipino): Ang bango ng bulaklak sa hardin.\r\n Example (English):
    The flowers in the garden smell fragrant.\r\n"
  m_isRightToLeft: 0
