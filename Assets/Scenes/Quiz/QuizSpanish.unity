  - {fileID: 1374148388}
  - {fileID: 2104585791}
  - {fileID: 1759301719}
  - {fileID: 1919920666}
  feedbackText: {fileID: 481068268}
  questionNumberText: {fileID: 1771853398}
  finalScoreText: {fileID: 1827702699}
  motivationalText: {fileID: 808874628}
  highscoreText: {fileID: 1506403400}
  unlockPopupText: {fileID: 1764275908}
  quizTheme: {fileID: 8300000, guid: 020b735e1489e094a9f29a94a809e77b, type: 3}
  correctSFX: {fileID: 8300000, guid: a94ca6f5c6cc52f4188f050c9e478f8c, type: 3}
  wrongSFX: {fileID: 8300000, guid: a135db2575d733f43a99fb9c37d5bb1a, type: 3}
  confettiEffect: {fileID: 1652926930}
  backButton: {fileID: 507569287}
  gameMenuScene: GameMenu
  jsonFileName: QuizSpanish.json
  correctResponses:
  - 'Aba! Ang talino naman ng aking apo! Tama ''yan! '
  - 'Napakahusay, apo! Nag-aral ka talagang mabuti! '
  - 'Tama ka na naman, aking matalinong apo! '
  - Perpektong sagot! Parang kinalakihan mong aral kay Lola!
  - 'Tama! Pinapamukha mo akong sobrang proud, apo! '
  - 'Tama iyan, apo. Ipagpatuloy mo ''yan, ang galing mo! '
  - 'Pinagmamalaki ka ng iyong mga ninuno, apo! '
  - 'Magaling! Napapangiti mo ang puso ni Lola ngayon! '
  wrongResponses:
  - 'Huwag kang mag-alala, makukuha mo ''yan sa susunod! '
  - 'Muntik na, apo! Konting aral pa at makukuha mo na. '
  - 'Ay, ayos lang ''yan, minsan nagkakamali rin si Lola! '
  - 'Hindi ito ang tamang sagot, pero ganyan tayo matuto, anak. '
  - 'Hmm, mali sa pagkakataong ito. Pero huwag kang susuko, ha? '
  - 'Ayos lang ''yan, apo. Ang mahalaga, ginawa mo ang lahat ng iyong makakaya. '
  - 'Oops, hindi iyon! Mas galingan natin sa susunod! '
  - 'Huwag kang malungkot, apo. Bawat pagkakamali ay hakbang papalapit sa pagkatuto. '
  successMessages:
  - 'Pumasa ang aking apo! Sobrang proud sa iyo si Lola! '
  - 'Nagawa mo, apo! Nagbunga ang lahat ng iyong pagsisikap! '
  - Napakaganda! Pinaganda mo ang araw ni Lola!
  - 'Kita mo na? Sabi ko sa iyo kaya mo! Napakagaling! '
  - 'Pumasa ka nang may napakataas na marka! Punong-puno ng galak ang puso ni Lola! '
  - 'Apo, ang galing-galing mo! Patuloy lang sa pag-aaral at pagningning! '
  retryMessages:
  - 'Ay, huwag kang malungkot, apo. Ang minsang pagbagsak ay hindi nangangahulugang
    titigil ka na sa pagsubok. '
  - 'Ayos lang ''yan, apo. Kahit ang pinakamaliwanag na bituin ay nagsimula sa maliit. '
  - 'Aww, hindi ka pumasa, pero ayos lang. Ang mahalaga, sinubukan mo. '
  - 'Ang pagbagsak ay hindi katapusan, apo ko, isa lamang itong aral. '
  - 'Ayos lang magpahinga, pero huwag na huwag kang aalis. Laging sinusuportahan
    ka ni Lola. '
  - 'Ay, apo ko, ang pagkakamali ay bahagi ng paglaki. Mas liliwanag ka sa susunod! '
  sessionQuestionLimit: 20
  feedbackDisplaySeconds: 3
  unlockScoreThreshold: 15
  checkIcon: {fileID: 1771280087}
  xIcon: {fileID: 26918263}
